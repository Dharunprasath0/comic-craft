# Copy to .env for local use. Never commit your real .env file.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model overrides. Defaults match the current stable choices used by this project.
GEMINI_FLASH_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
